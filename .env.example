# Server
API_HOST=0.0.0.0
# Character control (single worker; blank data root uses repository data/)
ASSET_DATA_ROOT=
CHARACTER_OWNER_ID=1
BLENDER_PORT=9878
BLENDER_EXECUTABLE=
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
API_KEY=

# JWT authentication
JWT_SECRET=replace-this-with-a-random-32-byte-secret
JWT_MIN_SECRET_LENGTH=32
JWT_ISSUER=signight
JWT_AUDIENCE=signight-client
PUBLIC_PATHS=

# Meshy 3D generation
WORLD_3D_PROVIDER=meshy
MESHY_API_KEY=
MESHY_API_BASE_URL=https://api.meshy.ai
MESHY_POLL_INTERVAL_SECONDS=5
WORLD_3D_API_TIMEOUT_SECONDS=900
MESHY_AI_MODEL=latest
MESHY_MODEL_TYPE=standard
MESHY_TOPOLOGY=quad
MESHY_TARGET_POLYCOUNT=30000
MESHY_TEXTURE_FINISH=matte
MESHY_AUTO_RIG_CHARACTER=true
MESHY_GENERATE_BASIC_ANIMATIONS=true
MESHY_LOCK_FACE_WEIGHTS=true
MESHY_FACE_LOCK_MODE=strict
WORLD_SKIN_WASM_PATH=

# Optional reference-image generation
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
OPENAI_API_KEY=

# Optional S3 persistence
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_DIR=world-assets

# Optional PostgreSQL persistence
# DATABASE_URL=postgresql://asset_user:password@localhost:5432/asset_3d
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=asset_3d
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=asset-3d-api
DB_CONNECT_MAX_RETRIES=2
DB_CONNECT_RETRY_BACKOFF=0.5

# Dedicated character index; migration is explicit, never on application startup.
# CHARACTER_DATABASE_URL=postgresql://character_user:password@127.0.0.1:55432/gaesup_character
CHARACTER_DATABASE_URL=
